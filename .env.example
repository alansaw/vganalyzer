# Backend
PORT=4000
# Defaults to postgresql://<your-os-user>@localhost:5432/vganalyzer if unset
DATABASE_URL=postgresql://localhost:5432/vganalyzer
# Market data provider: "yahoo" (live, no API key) or "mock" (deterministic, for tests/demo)
MARKET_PROVIDER=yahoo
# Number of recommendations to surface
RECOMMENDATION_COUNT=12
# How long a recommendation batch stays fresh before auto-regeneration (minutes)
RECOMMENDATION_TTL_MIN=720
