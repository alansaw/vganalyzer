PORT=4000
DATABASE_URL=postgresql://localhost:5432/vganalyzer
MARKET_PROVIDER=yahoo
RECOMMENDATION_COUNT=12
RECOMMENDATION_TTL_MIN=720

# --- Authentication (optional locally, required in production) ---
# Auth is ENABLED when at least one password is set; with none set, every
# request is treated as admin (local dev / tests).
# Accounts: "admin" / ADMIN_PASSWORD (full access), "user" / VIEWER_PASSWORD (read-only).
# ADMIN_PASSWORD=change-me
# VIEWER_PASSWORD=change-me-too
# SESSION_SECRET=any-long-random-string
